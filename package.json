{
  "name": "electric-store",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0 --port 5000",
    "build": "vite build",
    "start": "node server/index.js",
    "render-build": "npm install && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^5.1.4"
  },
  "devDependencies": {}
}
